# AMG's settings. Copy this file to .env, next to pyproject.toml, and fill it in.
# Anything already set in the environment (the shell, or the systemd unit) wins
# over this file. On the server it's /opt/amg/app/.env, readable by root and the
# amg user only. Never commit .env.

# --- Claude, which reads receipts ------------------------------------------
# A key from https://console.anthropic.com. Without one, AMG still runs, but
# uploaded receipts can't be read.
ANTHROPIC_API_KEY=

# Which model reads receipts. Defaults to claude-opus-5-5, about 5¢ a receipt
# and the one the reading trial was scored on. claude-sonnet-5-5 costs about
# half that, claude-haiku-4-5 about a quarter; scripts/eval_receipts.py shows
# what the cheaper ones get wrong before you switch.
# AMG_CLAUDE_MODEL=claude-opus-5-5

# --- Where things live -------------------------------------------------------
# The database, stored receipts and backups. Defaults to data/ next to this
# file. The server's systemd unit sets /var/lib/amg, so leave it unset there.
# AMG_DATA_DIR=

# --- Login --------------------------------------------------------------------
# Send the session cookie over HTTPS only. Leave it off while AMG is served as
# plain HTTP inside the VPN: a Secure cookie is never sent back over HTTP, and
# you could never stay signed in.
# AMG_COOKIE_SECURE=1

# --- Alerts -------------------------------------------------------------------
# The daily run (8:00, a systemd timer) pushes what's newly due to your phone
# and emails a weekly digest. Each part is off until its settings are here; the
# Alerts page says what's missing and has a test button for each. Restart AMG
# after changing them (systemctl restart amg). docs/DEPLOY-proxmox.md, step 10.

# Where links in pushes and emails point: AMG as you reach it at home or on the VPN.
# AMG_BASE_URL=http://amg.home.arpa

# Pushes through ntfy (the ntfy app on your phone). Topics on ntfy.sh are open to
# anyone who knows the name, so make it long and random. No topic, no pushes.
AMG_NTFY_TOPIC=
# AMG_NTFY_URL=https://ntfy.sh
# Only for a topic that needs a token:
# AMG_NTFY_TOKEN=

# The weekly email, sent through your Gmail. The password is a Gmail *app
# password* (Google account → Security → 2-Step Verification → App passwords),
# not your Google password. Without both, no email.
AMG_SMTP_USER=
AMG_SMTP_PASSWORD=
# AMG_SMTP_HOST=smtp.gmail.com
# 587 uses STARTTLS; 465 uses SSL from the start.
# AMG_SMTP_PORT=587
# Who gets it; defaults to AMG_SMTP_USER.
# AMG_EMAIL_TO=
