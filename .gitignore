# Secrets — never commit (.env.deploy, the home network's addresses, included)
.env
.env.*
!.env.example
*.pem
*.key

# Copies of data that belong in data/, should one land elsewhere: databases
# (with their -wal and -shm files) and archives, such as a backup
*.sqlite3*
*.zip

# App data written at runtime (database, stored receipts/manuals)
data/

# Real scans used for extraction trials — personal information
samples/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
